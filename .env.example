# Local development role for the auth guard / role switcher.
# One of: coordinator | origin | destination
VITE_DEV_ROLE=coordinator

# Which Business Central environment the app reads from. The connector can
# return several (e.g. a Sandbox and Production); set this to the one that has
# your data + published extension. Falls back to the first environment if unset.
VITE_BC_ENVIRONMENT=DeVanUnlimited

# Emails passed to the "Create Transfer Order" Power Automate flow.
# Build-time vars: must be set before `npm run build` for the deployed app to
# send non-empty values (they fall back to '' when unset).
VITE_COORDINATOR_EMAIL=
VITE_DESTINATION_EMAIL=
